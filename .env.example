# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Stored only on the server and never exposed to client code.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# PORT: Server port (defaults to 3000 in development, 8080 on Cloud Run)
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
